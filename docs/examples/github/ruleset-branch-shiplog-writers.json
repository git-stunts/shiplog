{
  "name": "Shiplog ledger: restricted writers (_shiplog/**)",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/_shiplog/**"], "exclude": [] } },
  "rules": [ { "type": "creation" }, { "type": "update" } ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" },
    { "actor_id": null, "actor_type": "DeployKey", "bypass_mode": "always" }
  ]
}
