#!/usr/bin/env bats

# `git shiplog verify` signature path (#135).
#
# Each test signs with an SSH key generated by shiplog_setup_test_signing. The
# roster is .shiplog/allowed_signers: the policy points at it through
# allow_ssh_signers_file, and `git shiplog trust sync` (run by
# shiplog_standard_setup) points gpg.ssh.allowedSignersFile at the same file,
# which is what Git itself reads for SSH signature verification. No image-level
# key and no GPG are involved.

load helpers/common

JOURNAL_REF="refs/_shiplog/journal/prod"

setup() {
  shiplog_standard_setup
  git shiplog init >/dev/null
  export SHIPLOG_AUTO_PUSH=0
  export SHIPLOG_BORING=1
  export SHIPLOG_SERVICE="web"
  export SHIPLOG_STATUS="success"
  export SHIPLOG_REASON="signed deploy"

  shiplog_setup_test_signing
  # Roster: the key we sign with, under the test identity's principal.
  shiplog_write_allowed_signers_for_signing_key .shiplog/allowed_signers
  cat > .shiplog/policy.json <<'JSON'
{
  "version": "1.0.0",
  "require_signed": true,
  "allow_ssh_signers_file": ".shiplog/allowed_signers",
  "authors": {
    "default_allowlist": ["shiplog-tester@example.com"]
  }
}
JSON
  export SHIPLOG_SIGN=1
}

teardown() {
  unset SHIPLOG_SIGN SHIPLOG_AUTO_PUSH SHIPLOG_BORING
  unset SHIPLOG_SERVICE SHIPLOG_STATUS SHIPLOG_REASON
  shiplog_standard_teardown
}

write_signed_entry() {
  run git shiplog --boring --yes write
  if [ "$status" -ne 0 ]; then
    echo "--- write output ---"
    echo "$output"
  fi
  [ "$status" -eq 0 ]
  local sha
  sha=$(git rev-parse "$JOURNAL_REF")
  git cat-file commit "$sha" | grep -q '^gpgsig '
}

@test "verify accepts an SSH-signed entry whose key is in allowed_signers" {
  write_signed_entry

  run git shiplog --boring verify
  if [ "$status" -ne 0 ]; then
    echo "--- verify output ---"
    echo "$output"
  fi
  [ "$status" -eq 0 ]
  [[ "$output" == *"OK=1"* ]]
  [[ "$output" == *"BadSig=0"* ]]
  [[ "$output" == *"Unauthorized=0"* ]]
}

@test "verify rejects a signed entry once its key leaves allowed_signers" {
  write_signed_entry

  # Tamper: the roster now lists only an unrelated key, so the entry's
  # signature no longer maps to any principal.
  local other
  other=$(mktemp -d)
  ssh-keygen -q -t ed25519 -N '' -f "$other/id_ed25519"
  printf 'someone-else@example.com %s\n' "$(ssh-keygen -y -f "$other/id_ed25519")" > .shiplog/allowed_signers
  rm -rf "$other"

  run git shiplog --boring verify
  [ "$status" -ne 0 ]
  [[ "$output" == *"bad or missing signature"* ]]
  [[ "$output" == *"BadSig=1"* ]]
}

@test "verify rejects an unsigned entry when the policy requires signatures" {
  # Write with signing switched off; the env override wins over the policy.
  run env SHIPLOG_SIGN=0 git shiplog --boring --yes write
  [ "$status" -eq 0 ]
  local sha
  sha=$(git rev-parse "$JOURNAL_REF")
  ! git cat-file commit "$sha" | grep -q '^gpgsig '

  run git shiplog --boring verify
  [ "$status" -ne 0 ]
  [[ "$output" == *"BadSig=1"* ]]
}
