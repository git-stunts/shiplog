{
  "version": "1.0.0",
  "require_signed": false,
  "deployment_requirements": {
    "default": {
      "require_signed": true
    },
    "prod": {
      "require_ticket": true
    },
    "staging": {
      "require_signed": false
    }
  },
  "authors": {
    "default_allowlist": [
      "deploy-bot@example.com"
    ],
