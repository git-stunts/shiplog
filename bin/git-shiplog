#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
SHIPLOG_HOME="${SHIPLOG_HOME:-$DEFAULT_HOME}"
LIB_DIR="${SHIPLOG_LIB_DIR:-$SHIPLOG_HOME/lib}"

# -------- Config Defaults --------
# Ref layout (REF_ROOT, NOTES_REF, POLICY_REF, TRUST_REF) is resolved below,
# after the libraries are sourced; see "Ref layout".
DEFAULT_ENV="${SHIPLOG_ENV:-prod}"
SHIPLOG_BORING="${SHIPLOG_BORING:-0}"
SHIPLOG_AUTO_PUSH="${SHIPLOG_AUTO_PUSH:-1}"
SHIPLOG_AUTO_PUSH_FLAG="${SHIPLOG_AUTO_PUSH_FLAG:-0}"
export SHIPLOG_BORING
export SHIPLOG_AUTO_PUSH

if [ -z "${SHIPLOG_BOSUN_BIN:-}" ]; then
  if [ -x "$SHIPLOG_HOME/scripts/bosun" ]; then
    SHIPLOG_BOSUN_BIN="$SHIPLOG_HOME/scripts/bosun"
  else
    SHIPLOG_BOSUN_BIN="$(command -v bosun 2>/dev/null || echo bosun)"
  fi
fi
export SHIPLOG_BOSUN_BIN

# Policy state (filled by shiplog_policy_load in lib/policy.sh)
POLICY_SOURCE=""
POLICY_REQUIRE_SIGNED=""
POLICY_ALLOWED_SIGNERS_FILE=""
POLICY_ALLOWED_AUTHORS=""
POLICY_NOTES_REF=""

SHIPLOG_SIGN_EFFECTIVE=""
ALLOWED_AUTHORS_EFFECTIVE=""
SIGNERS_FILE_EFFECTIVE=""

# -------- Source Library Functions --------
[ -d "$LIB_DIR" ] || { echo "❌ shiplog: unable to locate lib dir ($LIB_DIR)" >&2; exit 1; }

for lib in common.sh policy.sh git.sh plugins.sh commands.sh; do
  if [[ ! -f "$LIB_DIR/$lib" ]]; then
    echo "❌ shiplog: missing required library: $LIB_DIR/$lib" >&2
    exit 1
  fi
  source "$LIB_DIR/$lib" || {
    echo "❌ shiplog: failed to source $lib" >&2
    exit 1
  }
done

need git
need jq

# Booleans read from the environment are parsed once, here, and fail closed:
# an unrecognized spelling is an error, never "off" (SLT.BUG.LIB.003 / CLI.007 / CLI.009).
shiplog_bool_var SHIPLOG_BORING SHIPLOG_BORING "${SHIPLOG_BORING:-}" 0
shiplog_bool_var SHIPLOG_AUTO_PUSH SHIPLOG_AUTO_PUSH "${SHIPLOG_AUTO_PUSH:-}" 1
if [ -n "${SHIPLOG_DRY_RUN:-}" ]; then
  shiplog_bool_var SHIPLOG_DRY_RUN SHIPLOG_DRY_RUN "$SHIPLOG_DRY_RUN" 0
  export SHIPLOG_DRY_RUN
fi
if [ -n "${SHIPLOG_SIGN:-}" ]; then
  shiplog_bool_var SHIPLOG_SIGN SHIPLOG_SIGN "$SHIPLOG_SIGN" 0
  export SHIPLOG_SIGN
fi
export SHIPLOG_BORING SHIPLOG_AUTO_PUSH

# Repository root for .shiplog/* lookups (policy file, plugins, signers paths).
# Git runs external subcommands in the caller's cwd, so this is computed once
# here and exported; the wrapped command in `run` keeps its own cwd (SLT.BUG.LIB.007).
SHIPLOG_REPO_ROOT=""
if SHIPLOG_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$SHIPLOG_REPO_ROOT" ]; then
  :
elif SHIPLOG_REPO_ROOT=$(git rev-parse --absolute-git-dir 2>/dev/null) && [ -n "$SHIPLOG_REPO_ROOT" ]; then
  SHIPLOG_REPO_ROOT="$(dirname "$SHIPLOG_REPO_ROOT")"
else
  SHIPLOG_REPO_ROOT=""
fi
export SHIPLOG_REPO_ROOT

# -------- Ref layout --------
# One root governs every Shiplog ref (#100). Precedence for the root:
#   SHIPLOG_REF_ROOT (env) > git config shiplog.refRoot > refs/_shiplog
# Derived from the root unless an explicit SHIPLOG_*_REF override is set:
#   POLICY_REF  = $REF_ROOT/policy/current   (override: SHIPLOG_POLICY_REF)
#   TRUST_REF   = $REF_ROOT/trust/root       (override: SHIPLOG_TRUST_REF)
#   NOTES_REF   = $REF_ROOT/notes/logs       (override: SHIPLOG_NOTES_REF, then policy notes_ref)
#   journals    = $REF_ROOT/journal/<env>    anchors = $REF_ROOT/anchors/<env>
shiplog_resolve_ref_root
JOURNALS_REF_PREFIX="$REF_ROOT/journal"
ANCHORS_REF_PREFIX="$REF_ROOT/anchors"
NOTES_REF_DEFAULT="$REF_ROOT/notes/logs"
NOTES_REF="${SHIPLOG_NOTES_REF:-$NOTES_REF_DEFAULT}"
POLICY_REF_DEFAULT="$REF_ROOT/policy/current"
POLICY_REF="${SHIPLOG_POLICY_REF:-$POLICY_REF_DEFAULT}"
TRUST_REF_DEFAULT="$REF_ROOT/trust/root"
TRUST_REF="${SHIPLOG_TRUST_REF:-$TRUST_REF_DEFAULT}"
# Helper scripts (sync-policy, bootstrap-trust, trust-sync, migrate) read the
# resolved layout from these so they never fall back to a hardcoded root.
export SHIPLOG_REF_ROOT="$REF_ROOT"
export SHIPLOG_REF_ROOT_SOURCE="$REF_ROOT_SOURCE"
export SHIPLOG_POLICY_REF="$POLICY_REF"
export SHIPLOG_TRUST_REF="$TRUST_REF"

shiplog_print_version() {
  printf 'shiplog %s\n' "$(shiplog_version)"
}

export GIT_ALLOW_REFNAME_COMPONENTS_STARTING_WITH_DOT=1

run_with_global_flags() {
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --env)
        shift
        if [ $# -eq 0 ]; then
          echo "❌ shiplog: --env requires a value" >&2
          exit 1
        fi
        SHIPLOG_ENV="$1"
        DEFAULT_ENV="$SHIPLOG_ENV"
        export SHIPLOG_ENV
        shift
        continue
        ;;
      --env=*)
        SHIPLOG_ENV="${1#*=}"
        if [ -z "$SHIPLOG_ENV" ]; then
          echo "❌ shiplog: --env requires a non-empty value" >&2
          exit 1
        fi
        DEFAULT_ENV="$SHIPLOG_ENV"
        export SHIPLOG_ENV
        shift
        continue
        ;;
      --no-push)
        SHIPLOG_AUTO_PUSH=0
        SHIPLOG_AUTO_PUSH_FLAG=1
        export SHIPLOG_AUTO_PUSH
        export SHIPLOG_AUTO_PUSH_FLAG
        shift
        ;;
      --push)
        SHIPLOG_AUTO_PUSH=1
        SHIPLOG_AUTO_PUSH_FLAG=1
        export SHIPLOG_AUTO_PUSH
        export SHIPLOG_AUTO_PUSH_FLAG
        shift
        ;;
      --version|-V)
        shiplog_print_version
        exit 0
        ;;
      --yes)
        SHIPLOG_ASSUME_YES=1
        export SHIPLOG_ASSUME_YES
        shift
        ;;
      --boring)
        SHIPLOG_BORING=1
        export SHIPLOG_BORING
        shift
        ;;
      --dry-run)
        SHIPLOG_DRY_RUN=1
        SHIPLOG_DRY_RUN_EXPLICIT=1
        export SHIPLOG_DRY_RUN
        export SHIPLOG_DRY_RUN_EXPLICIT
        shift
        ;;
      --dry-run=*)
        if ! SHIPLOG_DRY_RUN=$(shiplog_parse_bool "${1#*=}"); then
          echo "❌ shiplog: --dry-run accepts 1|true|yes|on|0|false|no|off, got '${1#*=}'" >&2
          exit 1
        fi
        SHIPLOG_DRY_RUN_EXPLICIT=1
        export SHIPLOG_DRY_RUN
        export SHIPLOG_DRY_RUN_EXPLICIT
        shift
        ;;
      --no-dry-run)
        SHIPLOG_DRY_RUN=0
        SHIPLOG_DRY_RUN_EXPLICIT=1
        export SHIPLOG_DRY_RUN
        export SHIPLOG_DRY_RUN_EXPLICIT
        shift
        ;;
      --help|-h)
        # Global help only before the subcommand name; afterwards the subcommand
        # owns --help so `git shiplog write --help` prints the write usage (#119).
        if [ ${#args[@]} -gt 0 ]; then
          args+=("$1")
          shift
          continue
        fi
        usage
        exit 0
        ;;
      --)
        # Before the subcommand `--` only ends global flag parsing. After it, the
        # separator belongs to the subcommand (`run -- --flag` wraps a command whose
        # first word starts with `-`, #139 C), so it is passed through intact.
        if [ ${#args[@]} -eq 0 ]; then
          shift
        fi
        args+=("$@")
        break
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  if [ ${#args[@]} -eq 0 ]; then
    run_command
  else
    run_command "${args[@]}"
  fi
}

run_with_global_flags "$@"
